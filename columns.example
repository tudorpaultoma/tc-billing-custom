# Column configuration for the billing aggregation SCF.
#
# Format:  <column name> = IN | OUT   (also accepted: <column name>,IN  or  <column name> OUT)
#   IN  = include this column in the output CSV
#   OUT = exclude it
# Lines starting with # are ignored. Blank lines are ignored.
#
# Columns NOT listed here keep their built-in default (shown below).
# To use this file: put it in COS and set CONFIG_BUCKET + CONFIG_KEY,
# or paste its lines into the COLUMN_CONFIG environment variable.
#
# Every available column is listed with its default and kind.
# To enable an opt-in column, uncomment it (change #Col to Col).
# To drop a default column, set it to OUT.

# [default group key]
Payer Account ID = IN

# [default group key]
Owner Account ID = IN

# [default group key]
BillingMode = IN

# [default group key]
ProductName = IN

# [default group key]
Region = IN

# [default group key]
InstanceName = IN

# [default group key]
TransactionType = IN

# [default group key]
StartDay = IN

# [default group key]
EndDay = IN

# [default pass-through]
Component Contracted Price = IN

# [default pass-through]
Component Price Measurement Unit = IN

# [default pass-through]
Component Usage Unit = IN

# [default pass-through]
SP Deduction Rate = IN

# [default pass-through]
Discount Multiplier = IN

# [default pass-through]
Blended Discount Multiplier = IN

# [default pass-through]
Currency = IN

# [default pass-through]
TaxRate = IN

# [default pass-through]
Product Code = IN

# [default pass-through]
Bill Month = IN

# [default summed]
Component Usage = IN

# [default summed]
OriginalCost = IN

# [default summed]
RI Deduction (Duration) = IN

# [default summed]
RI Deduction (Cost) = IN

# [default summed]
SP Deduction = IN

# [default summed]
SP Deduction(Cost) = IN

# [default summed]
Total Amount After Discount (Excluding Tax) = IN

# [default summed]
Voucher Deduction = IN

# [default summed]
Amount Before Tax = IN

# [default summed]
TaxAmount = IN

# [default summed]
Total Cost (Including Tax) = IN

# [opt-in  pass-through]  uncomment to enable:
